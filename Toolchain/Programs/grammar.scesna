// SIDDHCESNA-III EBNF Grammar Definition

Program         ::= { Line }
Line            ::= [ Label ] [ Instruction | Directive ] [ Comment ] NEWLINE

Label           ::= '@' IDENTIFIER
Directive       ::= '#define' IDENTIFIER NUMBER

Instruction     ::= OpZero
                      | OpOneReg
                      | OpTwoReg
                      | OpRegImm

OpZero          ::= 'NOP' | 'HALT' | 'JMP' | 'JZ' | 'JG' | 'JS' | 'JO' | 'JVB' | 'CALL' | 'RET'
OpOneReg        ::= ('NOT' | 'STR' | 'LOAD' | 'PUSH' | 'POP') REGISTER
OpTwoReg        ::= ('ADD' | 'SUB' | 'MUL' | 'DIV' | 'AND' | 'OR' | 'XOR' | 'BSL' | 'BSR' | 'CMP' | 'MOV') REGISTER ',' REGISTER
OpRegImm        ::= ('LUI' | 'LLI' | 'LRI') REGISTER ',' NUMBER

REGISTER        ::= 'r' [0-9] | 'r' '1' [0-5] | 'ACC' | 'SP' | 'MAR' | 'JTR'
IDENTIFIER      ::= [a-zA-Z_] [a-zA-Z0-9_]*
NUMBER          ::= HEX_NUM | DEC_NUM
HEX_NUM         ::= '0x' [0-9a-fA-F]+
DEC_NUM         ::= [0-9]+
Comment         ::= '//' [^\n]*